# ────────────────────────────────────────────────────────────────
# Variabili d'ambiente — ASD Judo Karate Sommavilla
# Copia questo file in `.env` e compila i valori.
# Nessun segreto/API key deve finire nel bundle client.
# ────────────────────────────────────────────────────────────────

# Endpoint di invio del modulo di contatto (Forminit).
# Ricevuto da Forminit nella forma: https://forminit.com/f/{formId}
# Se vuoto, il form simula l'invio in locale (utile in sviluppo).
PUBLIC_FORM_ENDPOINT=

# Identificatore opzionale della sorgente/utente Forminit (se richiesto dall'integrazione).
PUBLIC_FORMINIT_EMAIL=info@asdsommavilla.it

# Token pubblico Cloudflare Web Analytics (privacy-first, cookieless).
# Si ottiene nella dashboard Cloudflare (Account → Web Analytics → Manage).
# Se vuoto, il beacon Cloudflare NON viene caricato.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
