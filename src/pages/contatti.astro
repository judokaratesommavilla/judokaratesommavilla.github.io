---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BackgroundOrnaments from '../components/BackgroundOrnaments.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/vue/ContactForm.vue';
import PhoneButton from '../components/PhoneButton.astro';
import EmailButton from '../components/EmailButton.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import LocationMapLink from '../components/LocationMapLink.astro';
import { contacts } from '../data/contacts';
import { locations } from '../data/locations';
import { socials } from '../data/socials';
import { courseNavLabels } from '../data/navigation';
import { buildBreadcrumbs } from '../utils/seo';

const jsonLd = [
  buildBreadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Contatti', path: '/contatti/' },
  ]),
];
---

<BaseLayout
  title="Contatti | ASD Judo Karate Sommavilla"
  description="Contatta ASD Judo Karate Sommavilla per informazioni su Judo, Karate, Difesa Personale e Psicomotricità a Villafranca di Verona e Sommacampagna."
  image="/og/default.jpg"
  canonicalPath="/contatti/"
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Contatti"
    title="Curiosità?"
    subtitle="Hai una domanda? Vuoi sapere quale corso è più adatto a te o a tuo figlio? Contattaci: ti rispondiamo noi."
    image="gallery/villafranca4"
    imageAlt="La palestra di Villafranca di Verona della ASD Judo Karate Sommavilla"
    compact
  />

  <!-- Referenti -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="I referenti"
        title="Con chi parlare"
        text="Ogni percorso ha un referente diretto: scrivici, chiamaci o mandaci un messaggio WhatsApp."
      />
      <div class="referents-grid grid grid-cols-1 gap-[1.2rem] sm:grid-cols-2 lg:grid-cols-3">
        {contacts.referents.map((referent) => (
          <article
            class="referent reveal flex flex-col rounded-sm border border-line border-t-[3px] border-t-red bg-white p-6"
          >
            <div class="referent__head flex flex-col gap-[0.15rem]">
              <h3>{referent.name}</h3>
              <span class="text-[0.85rem] font-bold tracking-[0.14em] text-red uppercase">{referent.role}</span>
              <span class="text-[0.82rem] text-text-faint">
                {referent.courses.map((slug) => courseNavLabels[slug]).join(' · ')}
              </span>
            </div>
            <p class="mt-4 mb-0 font-display text-[1.35rem] font-bold">{referent.phoneDisplay}</p>
            <div class="referent__actions mt-[1.2rem] flex flex-wrap gap-[0.6rem]">
              <PhoneButton phone={referent.phone} display={referent.phoneDisplay} size="sm" label="Chiama" />
              <WhatsAppButton
                message={`Ciao, vorrei avere informazioni su ${referent.role}.`}
                courseName={referent.role}
                size="sm"
                label="WhatsApp"
                class="referent__wa"
              />
            </div>
          </article>
        ))}
      </div>
      <p class="presence-note reveal mt-8 max-w-[var(--container-narrow)] rounded-sm border border-dashed border-line px-[1.4rem] py-[1.1rem] text-[1.02rem] text-text-muted">{contacts.presenceNote}</p>
      <div class="email-note reveal mt-4 flex flex-wrap items-center justify-between gap-4 rounded-sm border border-dashed border-line px-[1.3rem] py-4">
        <EmailButton
          to={contacts.email}
          label="Scrivici un'email"
          subject="Richiesta informazioni"
        />
        <span class="email-note__text text-text-muted">
          Email unica per la società:{' '}
          <a href={`mailto:${contacts.email}`} class="font-bold text-red">{contacts.email}</a>
        </span>
      </div>
    </div>
  </section>

  <!-- Social -->
  <section class="section section--dark tatami">
    <BackgroundOrnaments dark />
    <div class="container">
      <SectionHeading eyebrow="Seguici" title="Le novità anche sui social" text="Segui gli aggiornamenti, le foto e le storie dalla palestra sui nostri canali." light />
      <div class="social-row grid max-w-[var(--container-narrow)] grid-cols-1 gap-6 sm:grid-cols-2">
        <a class="social-card reveal relative z-[1] flex items-center gap-[1.1rem] rounded border border-line-dark bg-ink-soft px-[1.6rem] py-[1.5rem] no-underline transition-all duration-[280ms] ease-[var(--ease)] hover:-translate-y-1 hover:border-red-line" href={socials.facebook} target="_blank" rel="noopener noreferrer">
          <span class="social-card__icon inline-flex h-12 w-12 flex-none items-center justify-center rounded-sm bg-red text-white" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-[1.5rem] w-[1.5rem]"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.23.2 2.23.2v2.47h-1.26c-1.24 0-1.62.77-1.62 1.56v1.88h2.76l-.44 2.9h-2.32V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
          </span>
          <span>
            <span class="social-card__name block font-display text-[1.35rem] font-semibold tracking-[0.04em] text-white uppercase">Facebook</span>
            <span class="social-card__handle block text-[0.95rem] text-text-dark-muted">judokaratesommavilla</span>
          </span>
          <span class="social-card__arrow ml-auto text-[1.4rem] leading-none text-red" aria-hidden="true">→</span>
        </a>
        <a class="social-card reveal relative z-[1] flex items-center gap-[1.1rem] rounded border border-line-dark bg-ink-soft px-[1.6rem] py-[1.5rem] no-underline transition-all duration-[280ms] ease-[var(--ease)] hover:-translate-y-1 hover:border-red-line" href={socials.instagram} target="_blank" rel="noopener noreferrer">
          <span class="social-card__icon inline-flex h-12 w-12 flex-none items-center justify-center rounded-sm bg-red text-white" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.9 5.9 0 0 0-2.13 1.38A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.8.72 1.48 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg>
          </span>
          <span>
            <span class="social-card__name block font-display text-[1.35rem] font-semibold tracking-[0.04em] text-white uppercase">Instagram</span>
            <span class="social-card__handle block text-[0.95rem] text-text-dark-muted">@asd.judo.sommavilla</span>
          </span>
          <span class="social-card__arrow ml-auto text-[1.4rem] leading-none text-red" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Sedi -->
  <section class="section section--paper">
    <div class="container">
      <SectionHeading
        eyebrow="Le sedi"
        title="Dove trovarci"
        text="Le nostre sedi e i link per raggiungerle con Google Maps."
      />
      <div class="sedi-list grid max-w-[var(--container-narrow)] grid-cols-1 gap-[1.2rem] sm:grid-cols-2">
        {locations.map((location) => (
          <article
            class="sede reveal rounded-sm border border-line bg-white p-6"
          >
            <h3>{location.name}</h3>
            <p class="my-2 mb-4 text-text-muted">
              {location.facility} · {location.address}, {location.zip} {location.city}
            </p>
            <LocationMapLink location={location} label="Vedi sulla mappa" />
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section section--dark tatami">
    <BackgroundOrnaments dark />
    <div class="container">
      <div class="form-wrap relative z-[1] grid grid-cols-[0.9fr_1.1fr] items-start gap-12 max-[860px]:grid-cols-1">
        <div class="form-wrap__intro reveal">
          <span class="eyebrow eyebrow--light">Scrivici</span>
          <h2 class="mt-[0.7rem]">Come possiamo aiutarti?</h2>
          <p class="mt-4 text-text-dark-muted">
            Compila il modulo: ti ricontatteremo appena possibile. Preferisci parlare subito?
            Usa WhatsApp o il telefono.
          </p>
          <div class="form-wrap__quick mt-[1.4rem] flex flex-wrap gap-[0.7rem]">
            <WhatsAppButton
              message="Ciao, vorrei avere informazioni sui vostri corsi."
              label="Scrivici su WhatsApp"
            />
            <PhoneButton phone={contacts.referents[3].phone} display={contacts.referents[3].phoneDisplay} label="Segreteria" variant="ghost-dark" />
          </div>
        </div>
        <div class="form-wrap__form rounded bg-paper p-[clamp(1.4rem,3vw,2rem)] text-text shadow-soft">
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

