---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SiteImage from '../../components/SiteImage.astro';
import { getCollection } from 'astro:content';
import { buildBreadcrumbs } from '../../utils/seo';
import { formatDateShort } from '../../utils/dates';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const jsonLd = [
  buildBreadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Galleria', path: '/galleria/' },
  ]),
];
---

<BaseLayout
  title="Galleria | ASD Judo Karate Sommavilla"
  description="News, approfondimenti e storie di Judo, Karate, Difesa Personale e Psicomotricità da ASD Judo Karate Sommavilla."
  image="/og/default.jpg"
  canonicalPath="/galleria/"
  noindex={posts.length === 0}
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Galleria &amp; News</span>
      <h1 class="blog-title mt-[0.8rem] text-[clamp(2.4rem,5vw,3.8rem)]">Novità dal tatami</h1>
      <p class="blog-intro mt-[0.6rem] mb-10 max-w-[60ch] text-text-muted">
        Approfondimenti, avvisi e storie della società. Questo spazio è pronto per i primi articoli.
      </p>

      {posts.length > 0 ? (
        <div class="posts-grid grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article
              class="post-card reveal rounded border border-line bg-white transition-all duration-[280ms] ease-[var(--ease)] hover:-translate-y-[3px] hover:shadow-soft"
            >
              <a href={`/galleria/${post.id}/`} class="flex h-full flex-col p-0 no-underline">
                {post.data.image && (
                  <SiteImage
                    src={post.data.image}
                    alt={post.data.imageAlt}
                    width={800}
                    aspectRatio="16 / 9"
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    loading="lazy"
                    class="post-card__media aspect-[16/9] w-full object-cover"
                  />
                )}
                <div class="post-card__body flex flex-1 flex-col gap-[0.6rem] p-6">
                  <span class="post-card__category text-[0.8rem] font-bold tracking-[0.16em] text-red uppercase">{post.data.category}</span>
                  <h2 class="text-[1.4rem]">{post.data.title}</h2>
                  <p class="m-0 text-[0.98rem] text-text-muted">{post.data.description}</p>
                  <time datetime={post.data.publishDate.toISOString()} class="text-[0.85rem] text-text-faint">
                    {formatDateShort(post.data.publishDate.toISOString().slice(0, 10))}
                  </time>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="blog-empty max-w-[46rem] rounded border border-dashed border-line p-12 text-center">
          <span class="blog-empty__marker mb-4 inline-block h-[1.1rem] w-[1.1rem] bg-red" aria-hidden="true"></span>
          <h2>Articoli in arrivo</h2>
          <p class="text-text-muted">
            Stiamo preparando i primi contenuti del blog. Nel frattempo scopri i nostri corsi
            o scrivici per qualsiasi domanda.
          </p>
          <div class="blog-empty__actions mt-6 flex flex-wrap justify-center gap-[0.8rem]">
            <CTAButton label="Scopri i corsi" href="/sport/" />
            <CTAButton label="Contattaci" href="/contatti/" variant="ghost" />
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

