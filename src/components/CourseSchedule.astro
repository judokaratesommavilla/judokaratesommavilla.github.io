---
import type { Course } from '../data/types';
import { locationMap } from '../data/locations';

interface Props {
  course: Course;
}

const { course } = Astro.props;

const scheduleByLocation = course.locations
  .map((slug) => ({
    location: locationMap[slug],
    rows: course.schedule.filter((entry) => entry.location === slug),
  }))
  .filter((block) => block.rows.length > 0);
---

<div class="schedule grid gap-6">
  {scheduleByLocation.map((block) => (
    <section
      class="schedule__block reveal overflow-hidden rounded border border-line bg-white [.section--dark_&]:border-line-dark [.section--dark_&]:bg-ink-soft"
    >
      <header class="flex items-center gap-[0.7rem] border-b border-line bg-paper-soft px-[1.4rem] py-4 [.section--dark_&]:border-line-dark [.section--dark_&]:bg-[rgba(255,255,255,0.04)]">
        <span class="h-[0.6rem] w-[0.6rem] flex-none bg-red" aria-hidden="true"></span>
        <h4 class="m-0 text-[1.2rem]">{block.location.name}</h4>
        <span class="ml-auto text-[0.85rem] text-text-muted [.section--dark_&]:text-text-dark-muted">{block.location.facility}</span>
      </header>
      <ul class="m-0 list-none p-0">
        {block.rows.map((row) => (
          <li
            class="grid grid-cols-[1fr_1fr_auto] items-center gap-4 border-b border-line px-[1.4rem] py-[0.85rem] last:border-b-0 [.section--dark_&]:border-line-dark max-[560px]:[grid-template-columns:1fr_auto] max-[560px]:[grid-template-areas:'group_group'_'days_time'] max-[560px]:gap-x-4 max-[560px]:gap-y-0.5"
          >
            <span class="font-display text-[1.1rem] font-semibold tracking-[0.04em] uppercase max-[560px]:[grid-area:group]">{row.group}</span>
            <span class="text-[0.95rem] text-text-muted [.section--dark_&]:text-text-dark-muted max-[560px]:[grid-area:days]">{row.days}</span>
            <span class="whitespace-nowrap font-display text-[1.05rem] font-bold tracking-[0.05em] text-red max-[560px]:[grid-area:time]">{row.time}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

