---
import type { Instructor } from '../data/types';
import SiteImage from './SiteImage.astro';

interface Props {
  instructor: Instructor;
}

const { instructor } = Astro.props;
---

<article class="group reveal flex h-full flex-col overflow-hidden rounded border border-line bg-white transition-all duration-[280ms] ease-[var(--ease)] hover:-translate-y-1 hover:shadow-soft [.section--dark_&]:border-line-dark [.section--dark_&]:bg-ink-soft">
  <div class="overflow-hidden border-b border-line [.section--dark_&]:border-line-dark">
    <SiteImage
      src={instructor.image ?? ''}
      alt={`${instructor.name}, ${instructor.role} di ASD Judo Karate Sommavilla`}
      width={1640}
      aspectRatio="1 / 1"
      sizes="(min-width: 1024px) 200px, (min-width: 640px) 33vw, 46vw"
      class="aspect-square w-full object-cover transition-transform duration-[600ms] ease-[var(--ease)] group-hover:scale-[1.04]"
    />
  </div>
  <div class="flex flex-1 flex-col gap-[0.3rem] px-[1.2rem] pt-[1.1rem] pb-[1.3rem]">
    <h4 class="text-[1.35rem] text-text [.section--dark_&]:text-text-dark">{instructor.name}</h4>
    <p class="m-0 text-[0.95rem] text-text-muted [.section--dark_&]:text-text-dark-muted">{instructor.role}</p>
    {instructor.grade && instructor.grade.map((g) => (
      <span class="mt-[0.35rem] self-start rounded-full border border-red-line px-[0.65rem] py-[0.25rem] font-display text-[0.9rem] font-bold tracking-[0.06em] text-red">
        {g}
      </span>
    ))}
    {instructor.bio && <p class="mt-[0.4rem] text-[0.92rem] text-text-muted">{instructor.bio}</p>}
  </div>
</article>

