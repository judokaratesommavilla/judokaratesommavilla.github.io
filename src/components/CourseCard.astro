---
import type { ImageMetadata } from 'astro';
import type { Course } from '../data/types';
import SiteImage from './SiteImage.astro';
import childrenIcon from '../assets/icons/children.svg';
import defenceIcon from '../assets/icons/defence.svg';
import judoIcon from '../assets/icons/judo.svg';
import karateIcon from '../assets/icons/karate.svg';

interface Props {
  course: Course;
}

const { course } = Astro.props;

const courseIcons: Record<string, ImageMetadata> = {
  judo: judoIcon,
  karate: karateIcon,
  'difesa-personale': defenceIcon,
  psicomotricita: childrenIcon,
};

const courseIcon = courseIcons[course.slug] || judoIcon;
---

<article class="group reveal relative h-full overflow-hidden rounded border border-line bg-white transition-all duration-[280ms] ease-[var(--ease)] hover:-translate-y-[6px] hover:border-red hover:shadow-soft">
  <a href={`/sport/${course.slug}/`} class="flex h-full flex-col no-underline">
    <div class="relative overflow-hidden">
      <SiteImage
        src={course.image}
        alt={course.imageAlt}
        width={1000}
        aspectRatio="16 / 10"
        sizes="(min-width: 1024px) 25vw, 100vw"
        class="aspect-[16/10] w-full object-cover transition-transform duration-[600ms] ease-[var(--ease)] group-hover:scale-[1.05]"
      />
      <span
        class="absolute top-4 left-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-[rgba(13,15,18,0.5)] text-white backdrop-blur-[2px] transition-colors duration-[280ms] ease-[var(--ease)] group-hover:bg-red"
        aria-hidden="true"
      >
        <img src={courseIcon.src} alt="" width="512" height="512" decoding="async" class="h-8 w-8 object-contain invert" />
      </span>
      <span
        class="absolute right-4 bottom-4 max-w-[calc(100%-2rem)] rounded-sm bg-[rgba(13,15,18,0.78)] px-[0.7rem] py-[0.35rem] font-display text-[0.85rem] font-semibold tracking-[0.06em] text-white uppercase"
      >
        {course.category}
      </span>
    </div>
    <div class="flex flex-1 flex-col gap-[0.6rem] px-[1.9rem] py-[1.8rem] pb-8">
      <h3 class="text-[1.9rem]">{course.name}</h3>
      <p class="m-0 flex-1 text-base text-text-muted">{course.description}</p>
      <span
        class="mt-[0.9rem] inline-flex items-center gap-[0.55rem] self-start rounded-sm bg-red px-[1.1rem] py-[0.7rem] font-display text-[1.05rem] font-semibold tracking-[0.06em] text-white uppercase transition-colors duration-[280ms] ease-[var(--ease)] group-hover:bg-red-dark"
      >
        Scopri di più
        <span class="inline leading-none transition-transform duration-[280ms] ease-[var(--ease)] group-hover:translate-x-1" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>

