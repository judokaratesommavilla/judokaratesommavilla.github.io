---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  center?: boolean;
  /** Prop usato per ereditare lo stile scuro dai selettori del layout. */
  light?: boolean;
  level?: 1 | 2 | 3;
  class?: string;
}

const { eyebrow, title, text, center = false, level = 2, class: className = '' } = Astro.props;
const Tag = level === 1 ? 'h1' : level === 2 ? 'h2' : 'h3';
---

<div class:list={['section-head reveal', { 'section-head--center': center }, className]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag>{title}</Tag>
  {text && <p>{text}</p>}
</div>
